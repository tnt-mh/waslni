# Explicitly select demo for local-only demonstration data.
# Production is the default and never falls back to localStorage.
VITE_APP_MODE=production

# Supabase project settings. Only the public anon key belongs in the frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional integrations. Leave empty until the service is actually configured.
VITE_MAPBOX_TOKEN=
VITE_VAPID_PUBLIC_KEY=
